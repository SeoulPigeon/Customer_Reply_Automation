# Export these in the server process. This file is not loaded automatically.
APP_MAIL_MODE=mock
APP_AI_MODE=mock
APP_DATA_DIR=./var
APP_ENV=development
# Actual HTTPS origin after deployment. Never treat this placeholder as a deployed URL.
# APP_BASE_URL=
# APP_SECRET_DIR=/var/lib/gapyear-secrets
ENABLE_SCHEDULER=true
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false

# Inject secrets securely; never commit actual values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_FILE=/secure/google-token.json
# Gmail OAuth account is verified through Google; do not guess an address.
# GOOGLE_REFRESH_TOKEN=  # legacy integration only; prefer admin Gmail connection.
# GMAIL_ALIASES=
# GAPYEAR_OPENAI_API_KEY=
# OPENAI_MODEL=
# Initial defaults for new usage databases. Admin settings can update them afterwards.
# OPENAI_DAILY_REQUEST_LIMIT=100
# OPENAI_DAILY_TOKEN_LIMIT=250000
# OPENAI_USAGE_ALERT_PERCENT=80
# OPENAI_MAX_OUTPUT_TOKENS=2048
# SHEETS_SPREADSHEET_ID=
# SHEETS_TOKEN_FILE=/secure/sheets-token.json
# SHEETS_CLIENT_ID=
# SHEETS_CLIENT_SECRET=
# SHEETS_REFRESH_TOKEN=
