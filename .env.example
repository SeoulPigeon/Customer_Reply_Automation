# Export these in the server process. This file is not loaded automatically.
APP_MAIL_MODE=mock
APP_AI_MODE=mock
APP_DATA_DIR=./var
ENABLE_SCHEDULER=true
# Set true behind an HTTPS reverse proxy in production.
COOKIE_SECURE=false

# Inject secrets securely; never commit actual values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_TOKEN_FILE=/secure/google-token.json
# GMAIL_ADDRESS=
# GMAIL_ALIASES=
# GAPYEAR_OPENAI_API_KEY=
# OPENAI_MODEL=
# SHEETS_SPREADSHEET_ID=
# SHEETS_TOKEN_FILE=/secure/sheets-token.json
# SHEETS_CLIENT_ID=
# SHEETS_CLIENT_SECRET=
# SHEETS_REFRESH_TOKEN=
