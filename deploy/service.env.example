# systemd reads /etc/gapyear/service.env; the app does not automatically load .env.
# Keep the real file root-owned 0600. Edit on the server, never through chat or Git.
APP_ENV=production
APP_BASE_URL=
APP_DATA_DIR=/var/lib/gapyear
APP_SECRET_DIR=/var/lib/gapyear-secrets
COOKIE_SECURE=true
ENABLE_SCHEDULER=true
APP_MAIL_MODE=live
APP_AI_MODE=live
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_FILE=/var/lib/gapyear-secrets/gmail-token.json
GAPYEAR_OPENAI_API_KEY=
OPENAI_MODEL=
# Optional reporting export; not required for Gmail and OpenAI operation.
# SHEETS_SPREADSHEET_ID=
# SHEETS_TOKEN_FILE=/var/lib/gapyear-secrets/sheets-token.json
